{
  "name": "fixloop",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm --filter @fixloop/api exec tsx src/cli/seed.ts",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "fixtures:build": "pnpm --filter @fixloop/api exec node make-fixtures.mjs",
    "build": "pnpm --filter @fixloop/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "bench": "pnpm --filter @fixloop/api exec tsx scripts/benchmark.ts",
    "demo:reset": "pnpm db:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@prisma/client": "6.19.3",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
