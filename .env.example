DATABASE_URL=postgresql://fixloop:fixloop@localhost:54329/fixloop
SESSION_SECRET=local-dev-secret-please-change-0123456789abcdef
DEMO_MODE=true
PORT=4000
LLM_PROVIDER=fixture
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10000000

# Delivery of approved repair requests. "simulated" (default) stores them in the local database; nothing is sent.
# "email" sends them as real emails through the Resend API (https://resend.com) to TECHNICIAN_EMAIL.
DELIVERY=simulated
# Required only when DELIVERY=email:
# EMAIL_API_KEY=re_...
# EMAIL_FROM=FixLoop <onboarding@resend.dev>
# TECHNICIAN_EMAIL=technician@example.com
